{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "types": ["node", "@playwright/test"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@page-objects": ["./src/page-objects"],
      "@page-objects/*": ["./src/page-objects/*"],
      "@page-actions": ["./src/page-actions"],
      "@page-actions/*": ["./src/page-actions/*"],
      "@step-objects": ["./src/step-objects"],
      "@step-objects/*": ["./src/step-objects/*"],
      "@helpers": ["./src/helpers"],
      "@helpers/*": ["./src/helpers/*"],
      "@fixtures": ["./src/fixtures"],
      "@fixtures/*": ["./src/fixtures/*"],
      "@test-data": ["./src/test-data"],
      "@test-data/*": ["./src/test-data/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "e2e/**/*.ts",
    "api/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
